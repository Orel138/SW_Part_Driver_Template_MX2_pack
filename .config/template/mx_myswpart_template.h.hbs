{{assign 'myswpart_instances'  (@root.SWConfigurationAPI.getInstances "MyVendor::Board Part:STM32CubeMX2 Config:MySWPart")~}}

/* Define to prevent recursive inclusion -------------------------------------*/
#ifndef MX_MySWPart_H
#define MX_MySWPart_H

#ifdef __cplusplus
extern "C" {
#endif /* __cplusplus */

/* Includes ------------------------------------------------------------------*/
#include "myswpart.h"
#include "mx_hal_def.h"

/* Exported macros --------------------------------------------------------- */
{{#each @root.myswpart_instances~}}
{{assign 'ctx' (@root.SWConfigurationAPI.getSwInstanceConfiguration this)~}}
{{assign 'info' @root.ctx.info}}
{{assign 'resourcesAllocation' @root.ctx.resourcesAllocation}}
/* Part Config ID */
#define MySWPart_{{@index}}                              {{@index}} /* Main label */

{{#if (length @root.info.labels)}}
/* User-defined aliases for the part driver instance ID and getter function */
{{else}}
/* No label has been defined for this part driver instance,
 * so no alias is generated for MySWPart_{{@index}} or mx_myswpart_{{@index}}_getobject(). */
{{/if}}
{{#each @root.info.labels}}
#define {{this}}                              MySWPart_{{@../index}}
{{/each}}
{{#each @root.info.labels}}
#define {{lowercase this}}_getobject()        mx_myswpart_{{@../index}}_getobject()
{{/each}}

{{#if (eq @root.info.interface 'I2C')~}}
#define MySWPart_{{@index}}_I2C_GETHANDLE mx_{{lowercase @root.resourcesAllocation.i2cCfg.i2cInstance.selection}}_i2c_gethandle
#define MySWPart_{{@index}}_I2C_ADDRESS {{@root.resourcesAllocation.i2cCfg.i2cAddress.sa0Pad}}
{{!---------------------- EXTI Properties ----------------------------------------------------}}
{{#if (eq @root.resourcesAllocation.i2cCfg.interrupt1IsEnabled true)}}
{{assign 'extiLine' (@root.ExtiAPI.getExtiLine @root.resourcesAllocation.i2cCfg.extiCfg1.selection)~}}
/* MySWPart INT1 pin mapping */
#define MySWPart_{{@index}}_INT1_EXTI_GETHANDLE     mx_gpio_default_{{lowercase @root.extiLine}}_gethandle
{{/if}}
{{#if (eq @root.resourcesAllocation.i2cCfg.interrupt2IsEnabled true)}}
{{assign 'extiLine' (@root.ExtiAPI.getExtiLine @root.resourcesAllocation.i2cCfg.extiCfg2.selection)~}}
/* MySWPart INT2 pin mapping */
#define MySWPart_{{@index}}_INT2_EXTI_GETHANDLE     mx_gpio_default_{{lowercase @root.extiLine}}_gethandle
{{/if}}
{{/if}}
{{#if (eq @root.info.interface 'SPI')~}}
{{assign 'cs_gpio'(@root.pinoutAPI.getPinData @root.resourcesAllocation.spiCfg.pinCfg.selection)}}
#define MySWPart_{{@index}}_SPI_GETHANDLE    mx_{{lowercase @root.resourcesAllocation.spiCfg.spiInstance.selection}}_gethandle
#define MySWPart_{{@index}}_CS_PIN HAL_GPIO_PIN_{{@root.cs_gpio.index}}
#define MySWPart_{{@index}}_CS_PORT HAL_GPIO{{@root.cs_gpio.port}}
{{!---------------------- EXTI Properties ----------------------------------------------------}}
{{#if (eq @root.resourcesAllocation.spiCfg.interrupt1IsEnabled true)}}
{{assign 'extiLine' (@root.ExtiAPI.getExtiLine @root.resourcesAllocation.spiCfg.extiCfg1.selection)~}}
/* MySWPart INT1 pin mapping */
#define MySWPart_{{@index}}_INT1_EXTI_GETHANDLE     mx_gpio_default_{{lowercase @root.extiLine}}_gethandle
{{/if}}
{{#if (eq @root.resourcesAllocation.spiCfg.interrupt2IsEnabled true)}}
{{assign 'extiLine' (@root.ExtiAPI.getExtiLine @root.resourcesAllocation.spiCfg.extiCfg2.selection)~}}
/* MySWPart INT2 pin mapping */
#define MySWPart_{{@index}}_INT2_EXTI_GETHANDLE     mx_gpio_default_{{lowercase @root.extiLine}}_gethandle
{{/if}}
{{/if}}
myswpart_object_t *mx_myswpart_{{@index}}_getobject(void);
{{/each}}

#ifdef __cplusplus
}
#endif /* __cplusplus */

#endif /* MX_MySWPart_H */
