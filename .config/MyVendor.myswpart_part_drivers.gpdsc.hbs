{{assign 'myswpart_instances' (@root.SWConfigurationAPI.getInstances  "MyVendor::Board Part:STM32CubeMX2 Config:MySWPart")~}}
{{assign 'IsI2CioUsed' false~}}
{{assign 'IsSPIioUsed' false~}}
{{assign 'IsCustomioUsed' false~}}
{{#each @root.myswpart_instances~}}
{{assign 'ctx' (@root.SWConfigurationAPI.getSwInstanceConfiguration this)~}}
{{assign 'info'  @root.ctx.info~}}
{{#with @root.info~}}
{{#if (eq interface 'I2C')~}}
{{assign 'IsI2CioUsed' true~}}
{{/if}}
{{#if (eq interface 'SPI')~}}
{{assign 'IsSPIioUsed' true~}}
{{/if}}
{{#if (eq interface 'Custom')~}}
{{assign 'IsCustomioUsed' true~}}
{{/if}}
{{/with}}
{{/each}}
<?xml version="1.0" encoding="UTF-8"?>
<!-- ******************************************************************************
 * File Name   : {{@root.pdscAPI.getGPDSCFileName}}
 * Description : Generator PDSC File generated by CodeGen
 ****************************************************************************** -->
<package xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" schemaVersion="1.7.55" xsi:noNamespaceSchemaLocation="PACK.xsd" xmlns:stm32="https://developer.st.com/schemas/stm32cube/1.0.0" xsi:schemaLocation="https://developer.st.com/schemas/stm32cube/1.0.0 stm32cube.xsd">
  <vendor>{{@root.pdscAPI.getPackVendor}}</vendor>
  <name>{{@root.pdscAPI.getPackName}}</name>
  <url>{{@root.pdscAPI.getPackURL}}</url>
  <releases>
    <release version="0.5.0" date="2024-07-17">
      - First GPDSC template Model Release
    </release>
  </releases>
  <conditions>
    {{assign "conditions" (@root.pdscAPI.getAllPDSCConditionsWithFilters exclude="MySWPart CFG Condition")~}}
    {{{@root.conditions}}}
    {{!-- Excluded conditions by Id above could optionally be handled dynamically in this section--}}
    {{!-- #Start Dynamic condition handling section# --}}
    <condition id="MySWPart CFG Condition">
      <description>MyVendor configuration for MySWPart part driver</description>
{{#if (eq IsI2CioUsed true)}}
        <require Cclass="Board Part" Cgroup="Sensor" Csub="MySWPart Core"/>
        <require Cclass="Board Part" Cgroup="Sensor" Csub="MySWPart IO" Cvariant="I2C Polling"/>
{{/if}}
{{#if (eq IsSPIioUsed true)}}
        <require Cclass="Board Part" Cgroup="Sensor" Csub="MySWPart Core"/>
        <require Cclass="Board Part" Cgroup="Sensor" Csub="MySWPart IO" Cvariant="SPI Polling"/>
{{/if}}
{{#if (eq IsCustomioUsed true)}}
        <require Cclass="Board Part" Cgroup="Sensor" Csub="MySWPart Core"/>
        <require Cclass="Board Part" Cgroup="Sensor" Csub="MySWPart IO" Cvariant="Custom"/>
{{/if}}
    </condition>
    {{!-- #End Dynamic condition handling section# --}}

  </conditions>
  <components>
    {{#each components}}
    <component {{{generatorId}}} {{{Cclass}}} {{{Cgroup}}} {{{Csub}}} {{{Cbundle}}} {{{Cvariant}}} {{{Cversion}}} {{{condition}}}>
      <description>{{description}}</description>
      <files>
        {{#each files_array}}
        <file category="{{category}}" name="{{gen_file}}" />
        {{/each}}
      </files>
    </component>
    {{/each}}
  </components>
</package>
